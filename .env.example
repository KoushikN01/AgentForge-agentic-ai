# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real API keys.

# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini model to use. gemini-2.5-flash is fast/cheap and a good
# default while learning. You can switch to gemini-2.5-pro for higher
# quality, or a newer preview model as Google releases them.
GEMINI_MODEL=gemini-2.5-flash

# Python logging level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# Where the API's database lives. SQLite by default - a single local
# file, zero setup. Point this at a Postgres URL for a production-style
# database; nothing else needs to change.
DATABASE_URL=sqlite:///./agentforge.db

# Which Gemini model to use for embeddings (the RAG pipeline).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# "vector" (default): agentic retrieval over real Gemini embeddings in
# Chroma, falling back to free keyword search if the embedding call fails.
# "keyword": always use free keyword search, zero Gemini calls for RAG.
# See docs/rag.md.
RAG_MODE=vector
